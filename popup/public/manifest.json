{
  "name": "StreamTest",
  "version": "2.0.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "description": "Check any participant’s WebRTC video stream: live metrics, problems with likely causes, and a report to share.",
  "icons": {
    "16": "logo16.png",
    "32": "logo32.png",
    "48": "logo48.png",
    "128": "logo128.png",
    "512": "logo512.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "injection.js",
        "main.css",
        "assets/*"
      ],
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_icon": {
      "16": "logo16.png",
      "32": "logo32.png"
    }
  }
}
