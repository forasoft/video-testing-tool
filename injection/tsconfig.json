{
  "compilerOptions": {
    "outDir": "./dist/",
    "baseUrl": ".",
    "paths": {
      "shared/*": [
        "../shared/*"
      ],
      "*": [
        "*",
        "./src/*"
      ]
    },
    "strict": true,
    "module": "es6",
    "target": "ES2020",
    "jsx": "react",
    "allowJs": true,
    "moduleResolution": "node",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test"
  ]
}
